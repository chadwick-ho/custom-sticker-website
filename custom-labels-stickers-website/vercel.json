{
  "redirects": [
    {
      "source": "/custom-cartoon-stickers",
      "destination": "/custom-3d-holographic-labels",
      "permanent": true
    },
    {
      "source": "/custom-cartoon-stickers.html",
      "destination": "/custom-3d-holographic-labels",
      "permanent": true
    },
    {
      "source": "/custom-beverage-labels",
      "destination": "/custom-supplement-labels",
      "permanent": true
    },
    {
      "source": "/custom-beverage-labels.html",
      "destination": "/custom-supplement-labels",
      "permanent": true
    },
    {
      "source": "/cartoon-sticker-sheets-guide",
      "destination": "/custom-3d-holographic-labels",
      "permanent": true
    },
    {
      "source": "/cartoon-sticker-sheets-guide.html",
      "destination": "/custom-3d-holographic-labels",
      "permanent": true
    },
    {
      "source": "/waterproof-beverage-labels-guide",
      "destination": "/waterproof-peptide-vial-labels",
      "permanent": true
    },
    {
      "source": "/waterproof-beverage-labels-guide.html",
      "destination": "/waterproof-peptide-vial-labels",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
